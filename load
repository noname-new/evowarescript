
// ==UserScript==
// @name         EvoWars - Script Selector
// @namespace    NonameHub
// @version      1.0
// @description  Choose an EvoWars script to load
// @match        https://evowars.io/*
// @run-at       document-idle
// @grant        GM_xmlhttpRequest
// @connect      raw.githubusercontent.com
// ==/UserScript==

(() => {
    "use strict";

    const scripts = {
        killer: {
            name: "KILLER Hub",
            url: "https://raw.githubusercontent.com/noname-new/evowarescript/refs/heads/main/killer_obf.js"
        },
        v14: {
            name: "EvoWars v14.5",
            url: "https://raw.githubusercontent.com/noname-new/evowarescript/refs/heads/main/EvoWars_v14_5_obf.js"
        }
    };

    // UI
    const panel = document.createElement("div");

    panel.innerHTML = `
        <div id="ew-header">
            <span>EvoWars Script Selector</span>
            <button id="ew-close">×</button>
        </div>

        <div id="ew-content">
            <div class="ew-desc">Select a script to load</div>

            <button class="ew-option" data-script="killer">
                <span>KILLER Hub</span>
                <small>Auto Attack / ESP / Automation</small>
            </button>

            <button class="ew-option" data-script="v14">
                <span>EvoWars v14.5</span>
                <small>KOAX Atomic Strike</small>
            </button>

            <div id="ew-status">Waiting for selection...</div>
        </div>
    `;

    Object.assign(panel.style, {
        position: "fixed",
        top: "100px",
        right: "20px",
        width: "260px",
        background: "#151515",
        color: "#fff",
        border: "1px solid #333",
        borderRadius: "12px",
        fontFamily: "Arial, sans-serif",
        zIndex: "999999",
        boxShadow: "0 8px 30px #0008",
        overflow: "hidden"
    });

    const style = document.createElement("style");
    style.textContent = `
        #ew-header {
            padding: 13px;
            background: #202020;
            display: flex;
            justify-content: space-between;
            align-items: center;
            font-weight: bold;
        }

        #ew-close {
            background: transparent;
            color: white;
            border: none;
            font-size: 20px;
            cursor: pointer;
        }

        #ew-content {
            padding: 13px;
        }

        .ew-desc {
            color: #999;
            font-size: 12px;
            margin-bottom: 12px;
        }

        .ew-option {
            display: block;
            width: 100%;
            padding: 12px;
            margin-bottom: 9px;
            background: #252525;
            color: white;
            border: 1px solid #393939;
            border-radius: 8px;
            text-align: left;
            cursor: pointer;
        }

        .ew-option:hover {
            background: #303030;
            border-color: #7ce4c5;
        }

        .ew-option span {
            display: block;
            font-size: 14px;
            font-weight: bold;
        }

        .ew-option small {
            display: block;
            color: #999;
            margin-top: 5px;
            font-size: 11px;
        }

        #ew-status {
            color: #7ce4c5;
            font-size: 12px;
            margin-top: 12px;
        }
    `;

    document.head.appendChild(style);
    document.body.appendChild(panel);

    const status = panel.querySelector("#ew-status");
    const buttons = panel.querySelectorAll(".ew-option");

    let loaded = false;

    function loadScript(key) {
        if (loaded) return;

        const selected = scripts[key];
        if (!selected) return;

        if (!confirm(`Load ${selected.name}?`)) return;

        status.textContent = "Downloading...";
        buttons.forEach(btn => btn.disabled = true);

        GM_xmlhttpRequest({
            method: "GET",
            url: selected.url,

            onload(response) {
                if (response.status !== 200) {
                    status.textContent = "Download failed: " + response.status;
                    buttons.forEach(btn => btn.disabled = false);
                    return;
                }

                try {
                    const script = document.createElement("script");
                    script.textContent = response.responseText;

                    document.documentElement.appendChild(script);
                    script.remove();

                    loaded = true;
                    status.textContent = selected.name + " loaded!";
                } catch (error) {
                    status.textContent = "Execution failed!";
                    buttons.forEach(btn => btn.disabled = false);
                    console.error(error);
                }
            },

            onerror() {
                status.textContent = "Network error!";
                buttons.forEach(btn => btn.disabled = false);
            }
        });
    }

    buttons.forEach(button => {
        button.addEventListener("click", () => {
            loadScript(button.dataset.script);
        });
    });

    panel.querySelector("#ew-close").onclick = () => {
        panel.remove();
        style.remove();
    };
})();
